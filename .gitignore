logs/
*.log

# ----- OS / Editor -----
.DS_Store
Thumbs.db
*.suo
*.user
.idea/
.vscode/settings.json
*.swp
*~

# ----- Temp / Cache -----
__pycache__/
*.pyc
*.pyo
.cache/
